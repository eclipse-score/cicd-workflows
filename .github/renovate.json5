{
  // Central config for the hourly Renovate job in _local_daily.yml.
  // Read this file in three parts:
  //   1. repositories: which consumer repositories the bot visits;
  //   2. customManagers: how it reads component versions from uses: comments;
  //   3. packageRules: which extracted dependencies may produce update PRs.
  // Bazel modules use Renovate's built-in reader. Ordinary GitHub Actions are
  // left to Dependabot. See ../renovate.md for examples and consumer opt-in.
  //
  // Regex strings below are JSON-escaped: \\d in this file means \d (a digit)
  // to the regex engine. File/package matchers use /.../ to mark a regex;
  // matchStrings and allowedCommands contain the regex directly, without /.../.

  // Use Renovate's recommended baseline (PR limits, grouping, etc.)
  // ":disableDependencyDashboard" must be listed after "config:recommended" so it wins
  // during preset expansion. A bare `dependencyDashboard: false` is not enough because
  // Renovate expands presets from resolvedRepoConfig on top of the global config, which
  // causes config:recommended's ":dependencyDashboard" to overwrite the explicit override.
  // See: https://github.com/renovatebot/renovate/pull/43686
  extends: ["config:recommended", ":disableDependencyDashboard"],

  // Commit author
  gitAuthor: "eclipse-score-bot <score-bot@eclipse.org>",

  // Consumer catalog: these are repositories USING dependencies, not the
  // repositories publishing them. A string uses the shared settings; an object
  // adds settings for that consumer only. Listing a consumer here enables the
  // Bazel rules; component updates also require the matchRepositories opt-in.
  repositories: [
    {
      repository: "eclipse-score/baselibs",
      // The integration example is a separate Bazel root with its own lockfile.
      // It consumes the checkout through local_path_override, so updates to the
      // top-level MODULE.bazel also change its transitive dependencies.
      // Renovate only refreshes the lockfile beside the MODULE.bazel it updates.
      postUpgradeTasks: {
        // Resolve dependencies from the consumer root to refresh its lockfile too.
        workingDirTemplate: "examples/integration",
        commands: ["bazelisk mod deps --lockfile_mode=update"],
        // Ensure Bazelisk is available even when the consumer has no direct update.
        // Bazelisk selects the Bazel version from the repository's .bazelversion.
        installTools: { bazelisk: {} },
        // Resolve once after all updates on a branch, including grouped updates.
        executionMode: "branch",
        // Include only the consumer lockfile from this additional command.
        // Renovate still includes the normal manifest and lockfile updates.
        fileFilters: ["examples/integration/MODULE.bazel.lock"],
      },
    },
    "eclipse-score/bazel_cpp_toolchains",
    {
      repository: "eclipse-score/cicd-workflows",
      // This repository hosts the self-hosted config itself. Do not load its
      // default-branch copy as consumer config over the running configuration.
      requireConfig: "ignored",
    },
    "eclipse-score/communication",
    "eclipse-score/config_management",
    "eclipse-score/coverage_tool",
    "eclipse-score/devcontainer",
    "eclipse-score/docs-as-code",
    "eclipse-score/inc_security_crypto",
    "eclipse-score/inc_someip_gateway",
    "eclipse-score/infrastructure",
    "eclipse-score/itf",
    "eclipse-score/lifecycle",
    "eclipse-score/logging",
    "eclipse-score/module_template",
    "eclipse-score/openssl",
    "eclipse-score/os_autosd",
    "eclipse-score/os_images",
    "eclipse-score/process_description",
    "eclipse-score/qnx_sdp",
    "eclipse-score/qnx_sdp_pkg",
    "eclipse-score/qnx_unit_tests",
    "eclipse-score/persistency",
    "eclipse-score/reference_integration",
    "eclipse-score/rules_imagefs",
    "eclipse-score/sbom-tool",
    "eclipse-score/scrample",
    "eclipse-score/score",
    "eclipse-score/score-crates",
    "eclipse-score/score_cpp_policies",
    "eclipse-score/testing_tools",
    "eclipse-score/toolchains_gcc",
    "eclipse-score/toolchains_rust",
    "eclipse-score/time",
  ],

  // Include the update table, warnings, release notes and bot contact footer.
  // {{{...}}} inserts Renovate's generated Markdown without HTML escaping.
  prFooter: "This PR was generated by [#infrastructure](https://github.com/orgs/eclipse-score/discussions/107) automation. Contact us if you have any questions or feedback.",
  prBodyTemplate: "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}",

  // Add labels to all PRs, so we can actually find them
  labels: [
    "automation",
    "renovate",
  ],

  // Do not open onboarding PRs or require a local renovate.json. If a consumer
  // already has local config, it is still applied (unless its catalog entry
  // sets requireConfig: "ignored", as cicd-workflows does above).
  onboarding: false,
  requireConfig: "optional",

  // Kept for clarity; the actual suppression happens via :disableDependencyDashboard above.
  dependencyDashboard: false,

  // Limit open Renovate PRs to 10 per consumer, to avoid overwhelming maintainers.
  prConcurrentLimit: 10,

  // Override default weekly schedule from config:recommended so Renovate
  // runs every time the workflow triggers.
  schedule: ["at any time"],

  // Bazel updates apply to the repository catalog above. GitHub Actions updates
  // for component-prefixed SHA pins are enabled through the opt-in list below.
  enabledManagers: ["bazel-module", "custom.regex"],

  // Allow bazel lockfile updates via `bazel mod deps --lockfile_mode=update`
  allowedUnsafeExecutions: ["bazelModDeps"],

  // Explicit post-upgrade commands require their own global allowlist.
  // bazelModDeps above only permits Renovate's built-in lockfile refresh.
  // Anchor the expression to permit exactly the consumer refresh command.
  // ^ marks the start and $ the end: extra arguments or shell commands do not
  // match. This authorizes a command; it does not schedule or execute it itself.
  // Its repository and working directory are configured in repositories above.
  allowedCommands: ["^bazelisk mod deps --lockfile_mode=update$"],

  // Track component releases from the version comment while keeping the actual
  // uses: ref pinned to a commit. Lookup uses repository tags; dependency names
  // retain the action/workflow path so components stay independent.
  customManagers: [
    {
      // A custom manager extracts dependencies using named regex captures.
      // It does not execute the actions or workflows it finds.
      customType: "regex",
      managerFilePatterns: [
        // Workflow YAML below the repository-root .github/workflows/ directory.
        // ^ anchors the path at its start; .+ requires a filename; ya?ml accepts
        // both yml and yaml; $ requires the extension to end the path.
        "/^\\.github/workflows/.+\\.ya?ml$/",
        // Files named action.yml or action.yaml at any depth, including root.
        // (^|/) requires the name to start a path segment, so my-action.yml
        // does not match. This covers composite action definitions too.
        "/(^|/)action\\.ya?ml$/",
      ],
      matchStrings: [
        // Example input (SHA represents 40 lowercase hex characters):
        //   - uses: eclipse-score/cicd-actions/setup-bazel-cache@SHA # setup-bazel-cache/v0.1.0
        // (?m)^ starts at a line boundary. Optional indentation and "- " cover
        // both step-level actions and job-level reusable workflow calls.
        // Starting with uses: also leaves commented-out lines (# uses:) alone.
        // Spaces/tabs and optional quotes around the reference are accepted.
        //
        // Named captures provide Renovate's dependency fields:
        //   depName       = eclipse-score/cicd-actions (owner/repository)
        //   actionPath    = setup-bazel-cache (or .github/workflows/build.yml)
        //   currentDigest = SHA (exactly 40 characters from 0-9 or a-f)
        //   currentValue  = setup-bazel-cache/v0.1.0 (first token after #)
        // The negated character sets stop at separators, spaces and quotes.
        // A slash in currentValue is required here; versioningTemplate below
        // checks that this token really is a component release version.
        // Bare SHAs, ordinary # v1.2.3 comments and direct @component/v1.2.3
        // refs are not extracted. Trailing explanation after the token stays.
        "(?m)^[ \\t]*(?:-[ \\t]+)?uses:[ \\t]+['\"]?(?<depName>[^/\\s'\"]+/[^/@\\s'\"]+)(?:/(?<actionPath>[^@\\s'\"]+))?@(?<currentDigest>[0-9a-f]{40})['\"]?[ \\t]+#[ \\t]*(?<currentValue>[^/\\s]+/[^\\s'\"]+)",
      ],
      // Templates read the captures above. Triple braces insert their text as-is;
      // #if appends the optional path only when one was captured. The result is
      // the full dependency name, e.g. eclipse-score/cicd-actions/setup-bazel-cache.
      depNameTemplate: "{{{depName}}}{{#if actionPath}}/{{{actionPath}}}{{/if}}",
      // Tag lookup uses just the captured owner/repository, not the action path:
      // all component tags live in the same Git repository.
      packageNameTemplate: "{{{depName}}}",
      datasourceTemplate: "github-tags",
      // Parse the whole tag: ^ and $ require component/[v]MAJOR.MINOR.PATCH.
      // The slash separates the component; v? accepts versions with/without v;
      // \\d+ captures each number; \\. matches a literal dot between numbers.
      // "compatibility" is a Renovate field: candidates must have the SAME
      // component prefix as currentValue. Thus setup-bazel-cache/v0.1.0 can
      // update setup-bazel-cache/v0.0.1, but prune-cache/v9.0.0 and v99.0.0 cannot.
      // Short versions, nested component prefixes and prerelease tags do not
      // match this version format. No ordinary repository-tag fallback is used.
      versioningTemplate: "regex:^(?<compatibility>[^/]+)/v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      // Renovate's default replacement updates currentDigest and currentValue
      // together inside the matched text, preserving paths, quotes and comments.
    },
  ],

  // Rules are evaluated top to bottom; every matching rule contributes settings.
  // Later settings override earlier ones: first disable broadly, then opt in,
  // then apply restrictions. match... fields select dependencies; the other
  // fields control their updates. "enabled: true" does not mean automerge.
  packageRules: [
    {
      // By default bazel is enabled, but it shall update only score packages,
      // so disable all bazel module updates first.
      matchManagers: ["bazel-module"],
      enabled: false
    },
    {
      // And then re-enable only modules whose package name starts with "score_"
      matchManagers: ["bazel-module"],
      // /.../ marks a regex and ^ anchors the prefix: score_baselibs matches,
      // other_score_baselibs does not. This selects Bazel packages, not repos.
      matchPackageNames: ["/^score_/"],
      enabled: true,
    },
    {
      // Consumers opt in after excluding the component dependencies from
      // Dependabot. Standard GitHub Actions remain managed by Dependabot.
      matchManagers: ["custom.regex"],
      enabled: false,
    },
    {
      // Add consumers here and, if needed, to repositories above. Keep this
      // before the update-type restrictions so opt-in cannot bypass them.
      matchManagers: ["custom.regex"],
      // These are consumer repository names, not regex patterns. Register a
      // consumer here after adding Dependabot ignores for its component sources.
      matchRepositories: [
        "eclipse-score/cicd-workflows",
        "eclipse-score/docs-as-code",
      ],
      enabled: true,
      // Resolve the selected component tag to its commit SHA, keeping the
      // actual uses: reference pinned and the component tag in its comment.
      pinDigests: true,
      // Every generated update needs review. Keep major upgrades apart from
      // minor/patch updates, and offer distinct newer majors separately.
      automerge: false,
      separateMajorMinor: true,
      separateMultipleMajor: true,
    },
    {
      // Only release-version changes advance a pin. A moved tag or an existing
      // version whose SHA differs must not produce a standalone pin refresh.
      // "digest" means changing the SHA without changing the version;
      // "pinDigest" means adding a SHA pin. Neither is a release-version bump.
      matchManagers: ["custom.regex"],
      matchUpdateTypes: ["digest", "pinDigest"],
      enabled: false,
    },
    {
      // Combine eligible minor/patch changes into one PR per consumer. The slug
      // is the stable branch identifier, separate from the human-readable title.
      description: "Group routine minor and patch component updates.",
      matchManagers: ["custom.regex"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "GitHub Actions component updates",
      groupSlug: "gha-component-updates",
    },
    {
      // null clears grouping from inherited presets: major upgrades are reviewed
      // separately per component, rather than joining the minor/patch group.
      matchManagers: ["custom.regex"],
      matchUpdateTypes: ["major"],
      groupName: null,
    },
  ],
}
